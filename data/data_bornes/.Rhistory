df<-read.csv("data_VE.csv", sep = ";", encoding = "utf-8")
View(df)
# 1. Préparation des données
df <- df[!is.na(df$NB_VP_RECHARGEABLES_EL), ]  # Nettoyage si besoin
df <- df[order(df$Annee), ]  # Tri par année
# 2. Modèles
modele_lin <- lm(NB_VP_RECHARGEABLES_EL ~ Annee, data = df)
modele_quad <- lm(NB_VP_RECHARGEABLES_EL ~ poly(Annee, 2, raw = TRUE), data = df)
modele_exp <- lm(log(NB_VP_RECHARGEABLES_EL) ~ Annee, data = df)  # log pour modèle exp
# 1. Préparation des données
df <- df[!is.na(df$NB_VP_RECHARGEABLES_EL), ]  # Nettoyage si besoin
df <- df[order(df$Annee), ]  # Tri par année
df_exp <- df[df$NB_VP_RECHARGEABLES_EL > 0, ]
# 2. Modèles
modele_lin <- lm(NB_VP_RECHARGEABLES_EL ~ Annee, data = df)
modele_quad <- lm(NB_VP_RECHARGEABLES_EL ~ poly(Annee, 2, raw = TRUE), data = df)
modele_exp <- lm(log(NB_VP_RECHARGEABLES_EL) ~ Annee, data = df_exp)  # log pour modèle exp
# 3. Prédictions
df$pred_lin <- predict(modele_lin, newdata = df)
df$pred_quad <- predict(modele_quad, newdata = df)
df$pred_exp <- exp(predict(modele_exp, newdata = df))  # retransformer
# 4. Affichage des R²
cat("R² Linéaire :", summary(modele_lin)$r.squared, "\n")
cat("R² Quadratique :", summary(modele_quad)$r.squared, "\n")
cat("R² Exponentiel :", summary(modele_exp)$r.squared, "\n")
# 5. Visualisation
library(ggplot2)
ggplot(df, aes(x = Annee)) +
geom_point(aes(y = NB_VP_RECHARGEABLES_EL), color = "black", size = 2) +
geom_line(aes(y = pred_lin), color = "blue", linetype = "dashed", size = 1) +
geom_line(aes(y = pred_quad), color = "green", linetype = "dotdash", size = 1) +
geom_line(aes(y = pred_exp), color = "red", linetype = "solid", size = 1) +
labs(title = "Comparaison des modèles de régression",
y = "NB_VP_RECHARGEABLES_EL", x = "Année") +
theme_minimal()
# 1. Préparation des données
df_agg <- aggregate(NB_VP_RECHARGEABLES_EL ~ Annee, data = df, sum)
# Vérification
print(df_agg)
# Modèles
modele_lin <- lm(NB_VP_RECHARGEABLES_EL ~ Annee, data = df_agg)
modele_quad <- lm(NB_VP_RECHARGEABLES_EL ~ poly(Annee, 2), data = df_agg)
modele_exp <- lm(log(NB_VP_RECHARGEABLES_EL) ~ Annee, data = df_agg)  # si pas de 0
# log pour modèle exp
# 3. Prédictions
df$pred_lin <- predict(modele_lin, newdata = df)
df$pred_quad <- predict(modele_quad, newdata = df)
df$pred_exp <- exp(predict(modele_exp, newdata = df))  # retransformer
# 4. Affichage des R²
cat("R² Linéaire :", summary(modele_lin)$r.squared, "\n")
cat("R² Quadratique :", summary(modele_quad)$r.squared, "\n")
cat("R² Exponentiel :", summary(modele_exp)$r.squared, "\n")
# 5. Visualisation
library(ggplot2)
ggplot(df, aes(x = Annee)) +
geom_point(aes(y = NB_VP_RECHARGEABLES_EL), color = "black", size = 2) +
geom_line(aes(y = pred_lin), color = "blue", linetype = "dashed", size = 1) +
geom_line(aes(y = pred_quad), color = "green", linetype = "dotdash", size = 1) +
geom_line(aes(y = pred_exp), color = "red", linetype = "solid", size = 1) +
labs(title = "Comparaison des modèles de régression",
y = "NB_VP_RECHARGEABLES_EL", x = "Année") +
theme_minimal()
