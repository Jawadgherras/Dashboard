# 4. Prédiction jusqu’en 2030
annees_future <- data.frame(annee_mise_en_service = 2020:2030)
pred_lin_b <- predict(modele_lin_b, newdata = annees_future)
pred_quad_b <- predict(modele_quad_b, newdata = annees_future)
pred_exp_b <- exp(predict(modele_exp_b, newdata = annees_future))
# 5. Combiner pour visualiser
library(ggplot2)
df_pred_b <- data.frame(
Annee = 2020:2030,
Linéaire = pred_lin_b,
Quadratique = pred_quad_b,
Exponentiel = pred_exp_b
)
# Convertir pour ggplot (long format)
library(tidyr)
df_pred_long_b <- pivot_longer(df_pred_b, cols = -Annee, names_to = "Modèle", values_to = "Valeur")
# 6. Graphique comparatif
ggplot(df_pred_long_b, aes(x = Annee, y = Valeur, color = Modèle)) +
geom_line(size = 1.2) +
geom_point(data = df_borne_agg, aes(x = Annee, y = cumul_nb_borne), color = "black", size = 2) +
theme_minimal() +
labs(title = "🔌 Projection du nombre cumulé de bornes jusqu'en 2030",
x = "Année", y = "Nombre de bornes (cumul)",
color = "Modèle") +
scale_color_manual(values = c("Linéaire" = "royalblue", "Quadratique" = "darkgreen", "Exponentiel" = "red")) +
theme(plot.title = element_text(size = 14, face = "bold"))
# Si tu travailles avec un data.frame appelé df_bornes
names(df_2)[names(df_2) == "annee_mise_en_service"] <- "Annee"
# 1. Agréger les bornes installées par année
df_borne_agg <- aggregate(nb_borne ~ Annee, data = df_2, sum)
# 2. Créer la colonne cumulée
df_borne_agg$cumul_nb_borne <- cumsum(df_borne_agg$nb_borne)
# Vérification
print(df_borne_agg)
# 3. Modèles
modele_lin_b <- lm(cumul_nb_borne ~ Annee, data = df_borne_agg)
modele_quad_b <- lm(cumul_nb_borne ~ poly(Annee, 2), data = df_borne_agg)
modele_exp_b <- lm(log(cumul_nb_borne) ~ Annee, data = df_borne_agg)
# 4. Prédiction jusqu’en 2030
annees_future <- data.frame(Annee = 2020:2030)
pred_lin_b <- predict(modele_lin_b, newdata = annees_future)
pred_quad_b <- predict(modele_quad_b, newdata = annees_future)
pred_exp_b <- exp(predict(modele_exp_b, newdata = annees_future))
# 5. Combiner pour visualiser
library(ggplot2)
df_pred_b <- data.frame(
Annee = 2020:2030,
Linéaire = pred_lin_b,
Quadratique = pred_quad_b,
Exponentiel = pred_exp_b
)
# Convertir pour ggplot (long format)
library(tidyr)
df_pred_long_b <- pivot_longer(df_pred_b, cols = -Annee, names_to = "Modèle", values_to = "Valeur")
# 6. Graphique comparatif
ggplot(df_pred_long_b, aes(x = Annee, y = Valeur, color = Modèle)) +
geom_line(size = 1.2) +
geom_point(data = df_borne_agg, aes(x = Annee, y = cumul_nb_borne), color = "black", size = 2) +
theme_minimal() +
labs(title = "🔌 Projection du nombre cumulé de bornes jusqu'en 2030",
x = "Année", y = "Nombre de bornes (cumul)",
color = "Modèle") +
scale_color_manual(values = c("Linéaire" = "royalblue", "Quadratique" = "darkgreen", "Exponentiel" = "red")) +
theme(plot.title = element_text(size = 14, face = "bold"))
# R² du modèle linéaire
r2_lin <- summary(modele_lin_b)$r.squared
# R² du modèle quadratique
r2_quad <- summary(modele_quad_b)$r.squared
# R² du modèle exponentiel (on a fait la régression sur log(y))
r2_exp <- summary(modele_exp_b)$r.squared
# Affichage
cat("📊 Coefficients de détermination (R²) :\n")
cat("• Linéaire     :", round(r2_lin, 4), "\n")
cat("• Quadratique  :", round(r2_quad, 4), "\n")
cat("• Exponentiel  :", round(r2_exp, 4), "\n")
